<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Four Meta Vision — Compare preços. Escolha melhor.</title>
</head>
<body>

  <!-- ========== CABEÇALHO ========== -->
  <header class="header">

    <!-- Logo -->
    <a href="#" class="logo">
      <img src="logo-fmv.png" alt="Logo FMV" class="logo-img">
      <div class="logo-texto">
        <span class="logo-nome">FOUR <span class="logo-meta">META</span> VISION</span>
        <span class="logo-slogan">Enxergue mais. Escolha melhor.</span>
      </div>
    </a>

    <!-- Busca -->
    <form class="busca" role="search">
      <!-- ícone: lupa -->
      <input type="search" placeholder="Ex.: Ray-Ban RB 2140 Wayfarer" aria-label="Buscar modelo de óculos">
      <button type="submit">
        <!-- ícone: lupa -->
        Buscar
      </button>
    </form>

    <!-- Menu -->
    <nav class="menu">
      <ul>
        <li><a href="#" class="ativo">Início</a></li>
        <li><a href="#">Óculos de Sol</a></li>
        <li><a href="#">Óculos de Grau</a></li>
        <li><a href="#">Marcas</a></li>
        <li><a href="#">Lojas Parceiras</a></li>
        <li><a href="#">Escolha Consciente</a></li>
        <li><a href="#">Sobre nós</a></li>
      </ul>
    </nav>

  </header>

  <!-- ========== CONTEÚDO PRINCIPAL ========== -->
  <main>

    <!-- HERO -->
    <section class="hero">

      <div class="hero-conteudo">
        <h1>Compare preços.<br>Escolha melhor.</h1>
        <p class="hero-texto">
          Encontre o mesmo modelo de óculos em diferentes óticas
          e faça a melhor escolha para você e para o mundo.
        </p>

        <!-- Vantagens (4 ícones) -->
        <ul class="vantagens">
          <li class="vantagem">
            <!-- ícone: etiqueta de preço -->
            <span>Compare entre óticas parceiras</span>
          </li>
          <li class="vantagem">
            <!-- ícone: escudo com check -->
            <span>Compre com segurança e confiança</span>
          </li>
          <li class="vantagem">
            <!-- ícone: relógio -->
            <span>Economize tempo e dinheiro</span>
          </li>
          <li class="vantagem">
            <!-- ícone: folha -->
            <span>Escolhas sustentáveis e inclusivas</span>
          </li>
        </ul>
      </div>

      <!-- Foto do casal -->
      <div class="hero-imagem">
        <img src="casal.jpg" alt="Casal sorrindo usando óculos de sol e óculos de grau">
      </div>

      <!-- Barra de destaques -->
      <ul class="destaques">
        <li class="destaque">
          <!-- ícone: loja -->
          <span>Mais de 200 óticas parceiras</span>
        </li>
        <li class="destaque">
          <!-- ícone: óculos / modelos -->
          <span>Milhares de modelos para você</span>
        </li>
        <li class="destaque">
          <!-- ícone: globo -->
          <span>Impacto positivo em cada escolha</span>
        </li>
      </ul>

    </section>

  </main>

</body>
</html>
